# Copie para .env e troque os valores.
# Gere tokens longos, ex.: no PowerShell  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})

# Token que o script usa para ENVIAR coletas (vai no diag-servidor.cfg dos tecnicos)
UPLOAD_TOKEN=troque-este-token-de-envio

# Token para LISTAR/BAIXAR coletas na interface. Deixe vazio para liberar na rede.
READ_TOKEN=troque-este-token-de-leitura

# Tamanho maximo de cada coleta (MB)
MAX_MB=500
